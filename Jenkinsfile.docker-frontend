pipeline {
    agent any
    environment {
        DOCKER_BUILDKIT = '1'
    }
    stages {
        stage('Build Frontend Docker Image') {
            steps {
                bat 'docker build -t localhost:8082/frontend:latest -f Dockerfile.frontend .'
            }
        }
        stage('Login to Nexus Docker Registry') {
            steps {
                bat 'echo 123 | docker login localhost:8082 -u admin --password-stdin'
            }
        }
        stage('Push Frontend Image to Nexus') {
            steps {
                bat 'docker push localhost:8082/frontend:latest'
            }
        }
        stage('Cleanup Local Docker Images') {
            steps {
                bat 'docker rmi localhost:8082/frontend:latest || true'
            }
        }
    }
    post {
        always {
            echo 'Frontend Docker image built, pushed, and cleaned up.'
        }
    }
}
