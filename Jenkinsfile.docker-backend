pipeline {
    agent any
    environment {
        DOCKER_BUILDKIT = '1'
    }
    stages {
        stage('Build Backend Docker Image') {
            steps {
                sh 'docker build -t nexus.local:8082/backend:latest -f Dockerfile .'
            }
        }
        stage('Login to Nexus Docker Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-docker', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh 'echo $NEXUS_PASS | docker login nexus.local:8082 -u $NEXUS_USER --password-stdin'
                }
            }
        }
        stage('Push Backend Image to Nexus') {
            steps {
                sh 'docker push nexus.local:8082/backend:latest'
            }
        }
        stage('Cleanup Local Docker Images') {
            steps {
                sh 'docker rmi nexus.local:8082/backend:latest || true'
            }
        }
    }
    post {
        always {
            echo 'Backend Docker image built, pushed, and cleaned up.'
        }
    }
}
